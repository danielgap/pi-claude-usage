{
	"name": "@danielgap/pi-claude-usage",
	"version": "0.2.0",
	"description": "Claude subscription usage meter for pi-claude-bridge: registers the claude-bridge provider as a Gentle Shell usage source so the native usage bar and /gentle:usage panel show the 5-hour and weekly Claude windows.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"claude",
		"claude-code",
		"pi-claude-bridge",
		"usage",
		"quota"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/danielgap/pi-claude-usage.git"
	},
	"files": [
		"extensions/",
		"lib/",
		"README.md"
	],
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1",
		"@earendil-works/pi-tui": ">=0.85.1"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^24.13.3",
		"typescript": "^5.9.3"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/danielgap/pi-claude-usage/main/docs/usage-panel.png"
	}
}
